# Local development uses SQLite. Production must set a PostgreSQL URL.
DATABASE_URL=file:runway.sqlite

# AI Ingestion Parser Key (OpenRouter or Gemini)
OPENROUTER_API_KEY=
AI_API_KEY=

# Security
NEXTAUTH_SECRET=ledgerflow_super_secret_jwt_key_2026
PORT=3000
